# Copia este archivo a .env y completa con los datos de tu proyecto Supabase
# (Project Settings > API en el dashboard de Supabase).

# Usados por la app web (Vite los expone al navegador, deben ser el ANON key):
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY

# Solo para scripts/import_bd_registros.mjs (importación masiva por API).
# ⚠️ NUNCA expongas esta clave en el frontend ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
